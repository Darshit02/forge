{
  "name": "forge",
  "version": "1.0.0",
  "description": "AI-native backend IDE platform",
  "main": "src/index.ts",
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun --watch src/index.ts",
    "dev:frontend": "bun --cwd frontend dev",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:setup": "bash ./scripts/setup-docker.sh",
    "docker:ps": "docker ps --filter label=forge.project",
    "docker:clean": "bash ./scripts/cleanup-containers.sh",
    "smoke": "bash ./scripts/smoke-test.sh",
    "typecheck": "tsc --noEmit && bun run --cwd frontend typecheck",
    "lint": "echo 'No linter configured'",
    "test": "bun test"
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@ai-sdk/anthropic": "^1.1.8",
    "@ai-sdk/google": "^1.1.10",
    "@ai-sdk/openai": "^1.1.9",
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@hono/zod-validator": "^0.4.3",
    "adm-zip": "^0.5.16",
    "ai": "^4.1.40",
    "bcryptjs": "^3.0.2",
    "chokidar": "^4.0.3",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "simple-git": "^3.27.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/adm-zip": "^0.5.7",
    "@types/babel__traverse": "^7.20.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/dockerode": "^3.3.34",
    "@types/jsonwebtoken": "^9.0.9",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.3"
  }
}
