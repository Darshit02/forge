# Database Connection
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/forge

# Authentication Secrets
JWT_SECRET=forge-jwt-super-secret-key-change-in-production-1234
JWT_REFRESH_SECRET=forge-refresh-super-secret-key-change-in-production-5678

# AI Key Encryption Secret (32-byte base64 encoded)
# Generate with: openssl rand -base64 32
AI_KEY_ENCRYPTION_SECRET=eFR5UGFzQzlhblZtd1dYTkxQUVJaS1NUVVZXWVpBQkM=

# File Storage
PROJECTS_ROOT=.data/projects

# Port Allocation Range for User Containers
PORT_RANGE_START=8001
PORT_RANGE_END=9000

# Execution Engine Configuration
# auto: detects Docker if available, otherwise runs natively via process engine (Docker-free)
# process: runs directly via native process runner (no Docker required)
# docker: requires local Docker daemon
EXECUTION_ENGINE=auto

# Docker Socket Path (only used when EXECUTION_ENGINE=docker or detected)
# Linux: /var/run/docker.sock
# macOS: /Users/<user>/.docker/run/docker.sock or /var/run/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# Server & Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
